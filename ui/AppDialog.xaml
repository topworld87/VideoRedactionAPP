<Window x:Class="VideoBlackout.Wpf.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Blackout"
        Width="460" MinWidth="400" MaxWidth="520"
        SizeToContent="Height"
        MinHeight="140"
        Background="#12171F"
        Foreground="#E8ECF1"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#2C3645" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#151A22" Height="40"
              BorderBrush="#232B36" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <DockPanel Margin="12,0,4,0">
          <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="32"
                  Padding="0" Click="OnCloseClick" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/app-32.png" Width="16" Height="16" Margin="0,0,8,0"
                   IsHitTestVisible="False"/>
            <TextBlock x:Name="TitleText" Text="Video Blackout" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Margin="18,16,18,16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
        <TextBlock x:Name="LinkBlock" Margin="0,14,0,0" Visibility="Collapsed"
                   TextWrapping="Wrap" FontSize="13" LineHeight="20">
          <Run x:Name="LinkLabel" Foreground="#8B95A5"/>
          <LineBreak/>
          <Hyperlink x:Name="SourceLink" RequestNavigate="OnSourceNavigate" Foreground="#7EB6FF">
            <Run x:Name="LinkRun"/>
          </Hyperlink>
        </TextBlock>
        <TextBlock x:Name="DetailLabel" FontSize="11" Foreground="#8B95A5"
                   Margin="0,14,0,6" Visibility="Collapsed"/>
        <TextBox x:Name="DetailBox" Visibility="Collapsed" IsReadOnly="True"
                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 Background="#0F141B" Foreground="#C5CBD3" BorderBrush="#2C3645"
                 BorderThickness="1" Padding="10,8" Margin="0,0,0,2"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button x:Name="CancelBtn" Content="Cancel" MinWidth="88" Padding="12,8"
                  Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True"/>
          <Button x:Name="OkBtn" Style="{StaticResource PrimaryButton}" Content="OK"
                  MinWidth="88" Padding="12,8" Click="OnOkClick" IsDefault="True"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
