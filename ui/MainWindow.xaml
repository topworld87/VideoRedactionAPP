<Window x:Class="VideoBlackout.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoBlackout.Wpf"
        Title="Video Blackout"
        Width="1280" Height="780"
        Background="#0E1116"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Foreground="#E8ECF1"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown"
        Icon="Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <DockPanel>
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#151A22" Height="44"
            BorderBrush="#232B36" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="OnTitleBarMouseDown">
      <DockPanel Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/app-32.png" Width="20" Height="20" Margin="0,0,8,0"
                 IsHitTestVisible="False"/>
          <TextBlock Text="Video Blackout" FontWeight="Bold" FontSize="16" Margin="0,0,16,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Menu Background="Transparent" Foreground="#C5CBD3"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="{local:Tr menuFile}">
              <MenuItem Header="{local:Tr menuOpen}" Click="OnOpen"/>
              <MenuItem Header="{local:Tr menuAddFiles}" Click="OnAddFiles"/>
              <MenuItem Header="{local:Tr menuExit}" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="{local:Tr menuAccount}">
              <MenuItem Header="{local:Tr menuAccountItem}" Click="OnAccount"/>
              <MenuItem Header="{local:Tr menuUpgrade}" Click="OnUpgrade"/>
              <MenuItem x:Name="SignOutItem" Click="OnAccountSession"/>
            </MenuItem>
            <MenuItem Header="{local:Tr menuEdit}">
              <MenuItem Header="{local:Tr menuMask}">
                <MenuItem x:Name="MosaicItem" Header="{local:Tr menuMosaic}" IsCheckable="True" IsChecked="True" Click="OnModeMosaic"/>
                <MenuItem x:Name="BlurItem" Header="{local:Tr menuBlur}" IsCheckable="True" Click="OnModeBlur"/>
                <MenuItem x:Name="SolidItem" Header="{local:Tr menuSolid}" IsCheckable="True" Click="OnModeSolid"/>
              </MenuItem>
              <MenuItem Header="{local:Tr menuSettings}" Click="OnSettings"/>
            </MenuItem>
            <MenuItem Header="{local:Tr menuHelp}">
              <MenuItem Header="{local:Tr menuGuide}" Click="OnUserGuide"/>
              <MenuItem Header="{local:Tr menuDump}" Click="OnDumpDetectDebug"/>
              <MenuItem Header="{local:Tr menuLicenses}" Click="OnLicenses"/>
              <MenuItem Header="{local:Tr menuAbout}" Click="OnAbout"/>
            </MenuItem>
          </Menu>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="LangBtn" Style="{StaticResource LangButton}" Margin="0,0,8,0"
                  VerticalAlignment="Center" Click="OnLanguageClick"
                  PreviewMouseLeftButtonDown="OnLanguagePress"
                  ToolTip="{local:Tr langTip}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="LangCodeText" Text="EN" FontSize="12" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <Path Data="M 0 0.5 L 3.2 3.6 L 6.4 0.5" Stroke="#8B95A5" StrokeThickness="1.3"
                    Margin="7,1,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </StackPanel>
          </Button>
          <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangBtn}"
                 Placement="Bottom" VerticalOffset="8" StaysOpen="False"
                 AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#161B24" BorderBrush="#2A3340" BorderThickness="1"
                    CornerRadius="12" Padding="6" MinWidth="228">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55"/>
              </Border.Effect>
              <StackPanel>
                <TextBlock x:Name="LangMenuCaption" Text="{local:Tr langTip}" Margin="10,6,10,4"
                           FontSize="10" FontWeight="SemiBold" Foreground="#6E7886"/>
                <StackPanel x:Name="LangList"/>
              </StackPanel>
            </Border>
          </Popup>
          <Button Content="—" Width="40" Click="OnMin"/>
          <Button Content="☐" Width="40" Click="OnMax"/>
          <Button Content="✕" Width="40" Click="OnCloseWin"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="ProcessBar" DockPanel.Dock="Top" Background="#171C24" Height="52" BorderBrush="#232B36" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,8">
        <TextBlock x:Name="RuntimeStatus" DockPanel.Dock="Right" VerticalAlignment="Center"
                   Visibility="Collapsed" Foreground="#8B95A5" Text="GPU (DirectML)" Margin="12,0,0,0"/>
        <Button x:Name="PlanBtn" DockPanel.Dock="Right" Content="Free" Click="OnAccount"
                MinWidth="72" Padding="10,4" Margin="8,0,0,0" ToolTip="{local:Tr menuAccount}"/>
        <Button x:Name="AccountChip" DockPanel.Dock="Right" Click="OnAccount"
                VerticalAlignment="Center" Margin="8,0,0,0" Padding="3,2,8,2" MinHeight="28"
                ToolTip="{local:Tr accountChipGuest}">
          <StackPanel Orientation="Horizontal">
            <Grid Width="18" Height="18" Margin="0,0,6,0">
              <Ellipse x:Name="AccountAvatar" Fill="#243041"/>
              <Grid x:Name="AccountGuestIcon" Width="11" Height="11">
                <Ellipse Width="4.5" Height="4.5" Fill="#8B95A5"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0.4,0,0"/>
                <Path Data="M 0.4,10.4 C 1.1,6.6 2.8,5.4 5.5,5.4 C 8.2,5.4 9.9,6.6 10.6,10.4"
                      Stroke="#8B95A5" StrokeThickness="1.35"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
              </Grid>
              <TextBlock x:Name="AccountInitial" FontSize="10" FontWeight="Bold"
                         Foreground="#1A1205" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="AccountName" FontSize="11" FontWeight="SemiBold"
                       Foreground="#8B95A5" VerticalAlignment="Center"
                       MaxWidth="128" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Button>
        <Button x:Name="ProcessBtn" Style="{StaticResource PrimaryButton}" Content="Process all"
                Click="OnProcess" MinWidth="160"
                ToolTipService.ShowOnDisabled="True"/>
        <TextBlock x:Name="ProcessHint" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="#8B95A5" FontSize="12"/>
      </DockPanel>
    </Border>

    <Border x:Name="TimelineHost" DockPanel.Dock="Bottom" Background="#12171F" Height="176" BorderBrush="#232B36" BorderThickness="0,1,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#141A22" Height="32" BorderBrush="#232B36" BorderThickness="0,0,0,1">
          <DockPanel Margin="16,0,16,0">
            <TextBlock x:Name="AudioHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="#8B95A5" FontSize="11"
                       Text="{local:Tr audioHint}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <ToggleButton x:Name="AudioMuteBtn" Content="{local:Tr audioMute}" IsChecked="True"
                            ToolTip="{local:Tr tipAudioMute}" Click="OnAudioMute" Padding="10,4"
                            Margin="0,0,6,0"/>
              <ToggleButton x:Name="AudioBeepBtn" Content="{local:Tr audioBeep}"
                            ToolTip="{local:Tr tipAudioBeep}" Click="OnAudioBeep" Padding="10,4"
                            Margin="0,0,10,0"/>
              <Button x:Name="AudioDeleteBtn" Content="{local:Tr audioDelete}"
                      ToolTip="{local:Tr tipAudioDelete}" Click="OnAudioDelete" Padding="10,4"
                      IsEnabled="False"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <local:FilmstripTimeline x:Name="Timeline" Margin="16,2,16,8" IsEnabled="False"
                                 WindowChrome.IsHitTestVisibleInChrome="True"/>
      </DockPanel>
    </Border>

    <Border x:Name="FilePanel" DockPanel.Dock="Left" Width="320" Background="#12171F" BorderBrush="#232B36"
            BorderThickness="0,0,1,0" AllowDrop="True" Drop="OnFileListDrop" DragOver="OnFileListDragOver">
      <DockPanel Margin="12,12,12,10">
        <TextBlock DockPanel.Dock="Top" Text="{local:Tr filesTitle}" FontWeight="Bold" FontSize="12"
                   Foreground="#F2F5F8" Margin="2,2,2,10"/>
        <TextBlock DockPanel.Dock="Top" Text="{local:Tr jobTitle}" FontWeight="Bold" FontSize="11"
                   Foreground="#8B95A5" Margin="2,0,2,6"/>
        <Border DockPanel.Dock="Top" CornerRadius="8" BorderBrush="#2C3645" BorderThickness="1"
                Background="#1C2430" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="JobRedactBtn" Content="{local:Tr redactAll}" IsChecked="True"
                          ToolTip="{local:Tr jobHintRedact}"
                          Click="OnJobRedact" Padding="8,8" BorderThickness="0"/>
            <ToggleButton x:Name="JobKeepBtn" Grid.Column="1" Content="{local:Tr keepPeople}"
                          ToolTip="{local:Tr jobHintKeep}"
                          Click="OnJobKeep" Padding="8,8" BorderThickness="0"/>
          </Grid>
        </Border>
        <TextBlock x:Name="JobHint" DockPanel.Dock="Top" TextWrapping="Wrap"
                   Foreground="#8B95A5" FontSize="11" Margin="2,0,2,10"
                   Text="Mask every detected face and plate, then process the list."/>
        <StackPanel x:Name="DetectPanel" DockPanel.Dock="Top" Margin="0,0,0,10">
          <TextBlock Text="{local:Tr detectTitle}" FontWeight="Bold" FontSize="11"
                     Foreground="#8B95A5" Margin="2,0,2,6"/>
          <ComboBox x:Name="DetectCombo" SelectedIndex="0" SelectionChanged="OnDetectChanged">
            <ComboBoxItem Content="{local:Tr detectBoth}"/>
            <ComboBoxItem Content="{local:Tr detectFaces}"/>
            <ComboBoxItem Content="{local:Tr detectPlates}"/>
          </ComboBox>
        </StackPanel>
        <CheckBox x:Name="KeepPlatesCheck" DockPanel.Dock="Top" Content="{local:Tr keepPlates}"
                  IsChecked="True" Margin="2,0,2,10" Visibility="Collapsed"
                  Checked="OnKeepPlatesChanged" Unchecked="OnKeepPlatesChanged"/>
        <UniformGrid DockPanel.Dock="Bottom" Rows="2" Columns="2" Margin="0,8,0,0">
          <Button Content="{local:Tr addFiles}" Style="{StaticResource PrimaryButton}" Margin="0,0,3,3"
                  ToolTip="{local:Tr tipAddFiles}" Click="OnAddFiles"/>
          <Button Content="{local:Tr removeFile}" Margin="3,0,0,3"
                  ToolTip="{local:Tr tipRemoveFile}" Click="OnRemoveFile"/>
          <Button Content="{local:Tr clearDone}" Margin="0,3,3,0"
                  ToolTip="{local:Tr tipClearDone}" Click="OnClearDone"/>
          <Button Content="{local:Tr clearAll}" Margin="3,3,0,0"
                  ToolTip="{local:Tr tipClearAll}" Click="OnClearAll"/>
        </UniformGrid>
        <TextBlock x:Name="FileSummary" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                   Foreground="#8B95A5" FontSize="12" Margin="0,8,0,0"
                   Text="Drop videos or a folder here"/>
        <Border Background="#0F141B" BorderBrush="#232B36" BorderThickness="1" CornerRadius="8">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#151A22" BorderBrush="#232B36"
                    BorderThickness="0,0,0,1" Padding="10,8">
              <TextBlock Text="{local:Tr fileCol}" FontWeight="Bold" FontSize="11" Foreground="#8B95A5"/>
            </Border>
            <ListBox x:Name="FileList" MouseDoubleClick="OnFileDoubleClick"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="8,6"/>
                  <Setter Property="Margin" Value="2"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1A222D"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#243041"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusText}" Visibility="{Binding StatusVisible}"
                               Foreground="#8B95A5" FontSize="11" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>

    <Border x:Name="TrackPanel" DockPanel.Dock="Right" Width="300" Background="#12171F" BorderBrush="#232B36" BorderThickness="1,0,0,0">
      <DockPanel>
        <TextBlock x:Name="TargetTitle" DockPanel.Dock="Top" Text="DETECTED" FontWeight="Bold"
                   FontSize="12" Foreground="#F2F5F8" Margin="14,12,14,8"/>
        <TextBlock x:Name="TargetHint" DockPanel.Dock="Top" TextWrapping="Wrap"
                   Foreground="#8B95A5" FontSize="11" Margin="14,0,14,8"
                   Text="Checked items are masked. Uncheck one to leave it clear on this video."/>
        <StackPanel x:Name="MaskHeader" DockPanel.Dock="Bottom" Margin="14,8,14,0" Visibility="Collapsed">
          <TextBlock x:Name="MaskTitle" Text="MASK" FontWeight="Bold" FontSize="12" Foreground="#F2F5F8"/>
          <TextBlock x:Name="MaskHint" TextWrapping="Wrap" Foreground="#8B95A5" FontSize="11" Margin="0,4,0,4"/>
          <ListBox x:Name="MaskList" MaxHeight="140" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <Ellipse Width="8" Height="8" Fill="{Binding MaskBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="MaskEmpty" TextWrapping="Wrap" Foreground="#8B95A5" FontSize="12" Margin="0,2,0,8"/>
        </StackPanel>
        <Grid Margin="10,0,10,12">
          <ListBox x:Name="TrackList" SelectionMode="Single" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                            Visibility="{Binding MaskCheckVisible}"
                            Checked="OnTrackCheck" Unchecked="OnTrackCheck"/>
                  <StackPanel Orientation="Horizontal" Visibility="{Binding KeepLabelVisible}" Margin="0,2,0,2">
                    <Ellipse Width="8" Height="8" Fill="#3DDC84" Margin="0,0,8,0" VerticalAlignment="Center"
                             Visibility="{Binding KeepDotVisible}"/>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="22,4,0,2"
                              Visibility="{Binding SuggestVisible}">
                    <Button Content="{local:Tr samePerson}" Margin="0,0,6,0" Padding="8,2"
                            Click="OnConfirmIdentity" Tag="{Binding Id}"/>
                    <Button Content="{local:Tr notThem}" Padding="8,2" Click="OnRejectIdentity" Tag="{Binding Id}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="TargetEmpty" TextWrapping="Wrap" Foreground="#8B95A5" FontSize="12"
                     Margin="8,6" IsHitTestVisible="False"
                     Text="Play the video to see detections. Empty is OK — export still scans the file."/>
        </Grid>
      </DockPanel>
    </Border>

    <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="#10151C" Height="40" BorderBrush="#232B36" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <TextBlock x:Name="TimeCurrent" FontFamily="Consolas" FontSize="13" Foreground="#E8ECF1"
                       VerticalAlignment="Center" Text="00:00:00:00"/>
            <TextBlock x:Name="TimeTotal" FontFamily="Consolas" FontSize="13" Foreground="#8B95A5"
                       VerticalAlignment="Center" Margin="14,0,0,0" Text="00:00:00:00"
                       ToolTip="Left and right arrows step one frame. Shift steps one second."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PlayBtn" Content="▶" Width="44" Height="28" Padding="0"
                    Click="OnPlayPause" FontSize="13" IsEnabled="False"
                    ToolTip="Preview only — does not process or save the video"/>
            <ToggleButton x:Name="PreviewMuteBtn" Margin="8,0,0,0" Width="36" Height="28" Padding="0"
                          FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE767;"
                          ToolTip="{local:Tr tipPreviewMute}" Click="OnPreviewMute"
                          IsEnabled="False"/>
          </StackPanel>
          <Button x:Name="PreviewMaxBtn" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0"
                  Width="32" Height="28" Padding="0" Click="OnPreviewMaximize" VerticalAlignment="Center"
                  FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE740;"
                  ToolTip="Maximize preview"/>
        </Grid>
      </Border>
      <Border x:Name="PreviewToolBar" DockPanel.Dock="Top" Background="#141A22" Height="48">
        <DockPanel Margin="12,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="MaskToolLabel" Text="Will be masked" VerticalAlignment="Center"
                       Foreground="#E8A838" FontSize="12" Margin="16,0,8,0" Visibility="Collapsed"
                       ToolTip="Missed face or plate — will be masked"/>
            <ToggleButton x:Name="FollowBtn" Content="{local:Tr boxFollow}" IsChecked="True"
                          ToolTip="{local:Tr tipBoxFollow}" Click="OnToolFollow"/>
            <ToggleButton x:Name="PinBtn" Content="{local:Tr boxPin}" Margin="8,0,0,0"
                          ToolTip="{local:Tr tipBoxPin}" Click="OnToolPin"/>
          </StackPanel>
          <TextBlock x:Name="ToolHint" Text="If AI missed a face or plate, draw a box:" VerticalAlignment="Center"
                     Foreground="#8B95A5" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>
      <local:VideoCanvas x:Name="Canvas"/>
    </DockPanel>
  </DockPanel>
</Window>
