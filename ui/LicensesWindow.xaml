<Window x:Class="VideoBlackout.Wpf.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VideoBlackout.Wpf"
        Title="Video Blackout"
        Width="680" Height="560"
        MinWidth="480" MinHeight="360"
        Background="#12171F"
        Foreground="#E8ECF1"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                  ResizeBorderThickness="6"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#2C3645" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#151A22" Height="40"
              BorderBrush="#232B36" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <DockPanel Margin="12,0,4,0">
          <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="32"
                  Padding="0" Click="OnCloseClick" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="13"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
        </DockPanel>
      </Border>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="18,0,18,16">
        <Button Content="{local:Tr dlgViewLicense}" MinWidth="120" Padding="12,8"
                Margin="0,0,8,0" Click="OnViewLicense"/>
        <Button Style="{StaticResource PrimaryButton}" Content="{local:Tr dlgClose}"
                MinWidth="88" Padding="12,8" Click="OnCloseClick" IsCancel="True"/>
      </StackPanel>
      <TextBox x:Name="NoticeBox" Margin="18,16,18,12" IsReadOnly="True"
               IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap"
               BorderThickness="0" Background="#12171F" Foreground="#E8ECF1"
               FontSize="13" Padding="0"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
  </Border>
</Window>
