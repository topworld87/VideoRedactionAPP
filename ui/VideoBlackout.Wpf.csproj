<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\</OutputPath>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>VideoBlackout.Wpf</RootNamespace>
    <AssemblyName>VideoBlackout.Wpf</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\bin\version.ini')), '(?m)^version\s*=\s*([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)\s*$').Groups[1].Value)</AppVersion>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Video Blackout</Product>
    <Company>FlyAllRisk</Company>
    <AssemblyTitle>Video Blackout</AssemblyTitle>
    <Description>Offline video redaction for Windows</Description>
    <Copyright>Copyright © FlyAllRisk</Copyright>
  </PropertyGroup>
  <Target Name="ValidateAppVersion" BeforeTargets="BeforeBuild;GenerateAssemblyInfo">
    <Error Condition="'$(AppVersion)' == ''" Text="version.ini must contain version=Major.Minor.Build.Revision" />
  </Target>
  <ItemGroup>
    <Content Include="..\help\guide.html" Link="help\guide.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\legal\AGPL-3.0.txt" Link="legal\AGPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\legal\NOTICE.txt" Link="legal\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\legal\Apache-2.0.txt" Link="legal\Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-16.png" />
    <Resource Include="Assets\app-32.png" />
    <Resource Include="Assets\app-180.png" />
    <Resource Include="Assets\app-192.png" />
    <Resource Include="Assets\app-512.png" />
    <Resource Include="Assets\app.svg" />
  </ItemGroup>
</Project>
