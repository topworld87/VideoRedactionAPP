<Window x:Class="VideoBlackout.Wpf.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process"
        Width="500" MinWidth="440" MaxWidth="560"
        SizeToContent="Height"
        MinHeight="160"
        Background="#12171F"
        Foreground="#E8ECF1"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="Assets/app.ico">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Border BorderBrush="#2C3645" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#151A22" Height="40"
              BorderBrush="#232B36" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseDown">
        <DockPanel Margin="12,0,4,0">
          <Button DockPanel.Dock="Right" Content="✕" Width="36" Height="32"
                  Padding="0" Click="OnCancelClick" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/app-32.png" Width="16" Height="16" Margin="0,0,8,0"
                   IsHitTestVisible="False"/>
            <TextBlock x:Name="TitleText" Text="Process" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <StackPanel Margin="18,16,18,16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                   Text="Processing the video with your current settings.&#x0a;Please wait — the main window is locked until this finishes."/>
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Height="20" Margin="0,16,0,16"/>
        <Button x:Name="CancelBtn" Content="Cancel" MinWidth="88" Padding="12,8"
                HorizontalAlignment="Right" Click="OnCancelClick"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
