#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VB_VER_MAJOR@,@VB_VER_MINOR@,@VB_VER_PATCH@,@VB_VER_TWEAK@
PRODUCTVERSION @VB_VER_MAJOR@,@VB_VER_MINOR@,@VB_VER_PATCH@,@VB_VER_TWEAK@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FlyAllRisk"
            VALUE "FileDescription", "Video Blackout"
            VALUE "FileVersion", "@VB_VERSION@"
            VALUE "InternalName", "VideoBlackoutCore.dll"
            VALUE "LegalCopyright", "Copyright (C) FlyAllRisk. Licensed under the GNU AGPL v3."
            VALUE "OriginalFilename", "VideoBlackoutCore.dll"
            VALUE "ProductName", "Video Blackout"
            VALUE "ProductVersion", "@VB_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
